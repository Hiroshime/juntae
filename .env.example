# PostgreSQL connection used by Prisma.
POSTGRES_PORT=5433
DATABASE_URL="postgresql://galera:galera@localhost:5433/galera?schema=public"

# At least 32 characters in local and production environments.
AUTH_SECRET="replace-this-with-a-long-random-secret-at-least-32-characters"
REGISTRATION_BOOTSTRAP_TOKEN="replace-this-with-a-private-initial-registration-code"
APP_URL="http://localhost:3000"
DEFAULT_TIMEZONE="America/Sao_Paulo"

# Required only to store SMTP credentials. Generate once with: openssl rand -base64 32
# Keep this key stable and backed up; changing it makes saved community credentials unreadable.
EMAIL_CREDENTIALS_ENCRYPTION_KEY=""

# Optional installation-level SMTP used only for password recovery.
# Configure all six values together. Gmail: smtp.gmail.com / 465 / app password.
PASSWORD_RESET_SMTP_HOST=""
PASSWORD_RESET_SMTP_PORT=""
PASSWORD_RESET_SMTP_USER=""
PASSWORD_RESET_SMTP_PASSWORD=""
PASSWORD_RESET_FROM_NAME=""
PASSWORD_RESET_FROM_EMAIL=""
