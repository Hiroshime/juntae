# Published Docker Hub image. Replace SEU_USUARIO before installing.
GALERA_IMAGE=docker.io/SEU_USUARIO/galera:0.1.0

# ZimaOS host settings.
GALERA_PORT=3080
GALERA_DATA_PATH=/DATA/AppData/galera
APP_URL=http://IP_DO_ZIMAOS:3080

# Generate unique values before deployment. Never commit the real file.
POSTGRES_PASSWORD=troque-por-uma-senha-hexadecimal-forte
AUTH_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

DEFAULT_TIMEZONE=America/Sao_Paulo
