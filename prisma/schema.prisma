generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CommunityRole {
  OWNER
  ADMIN
  MEMBER
}

enum InviteStatus {
  ACTIVE
  REVOKED
}

enum ScheduleRuleType {
  WEEKLY
  CYCLE
}

enum ScheduleRuleStatus {
  ACTIVE
  INACTIVE
}

enum AvailabilityStatus {
  AVAILABLE
  PARTIALLY_AVAILABLE
  WORKING
  DAY_OFF
  VACATION
  UNAVAILABLE
  UNKNOWN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum RsvpStatus {
  GOING
  MAYBE
  NOT_GOING
}

enum PollType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  DATE_OPTIONS
}

enum PollStatus {
  OPEN
  CLOSED
}

enum RandomizerPresetType {
  TEAMS
  GROUPS
  CARS
  ASSIGN_ITEMS
  PICK_PEOPLE
  PICK_ITEM
  RANDOM_ORDER
  PAIRS
}

enum CostShareStatus {
  OPEN
  CLOSED
}

enum SocialPostKind {
  POST
  ANNOUNCEMENT
}

enum SocialContentFormat {
  PLAIN_TEXT
  MARKDOWN
}

enum SocialMediaKind {
  IMAGE
  VIDEO
}

enum SocialReactionType {
  LIKE
  LOVE
  CELEBRATE
  LAUGH
  SUPPORT
}

enum EmailProvider {
  GMAIL
  CUSTOM_SMTP
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum GameType {
  TIC_TAC_TOE
  HANGMAN
  STOP
}

enum GameRoomStatus {
  WAITING
  PLAYING
  CLOSED
}

enum GameMatchStatus {
  ACTIVE
  FINISHED
}

enum GameMatchOutcome {
  X_WON
  O_WON
  DRAW
  X_WON_FORFEIT
  O_WON_FORFEIT
}

enum HangmanSessionStatus {
  ACTIVE
  FINISHED
  CANCELLED
}

enum HangmanRoundStatus {
  SETTING_WORD
  GUESSING
  FINISHED
}

enum HangmanRoundOutcome {
  GUESSED
  HANGED
  CANCELLED
}

enum HangmanGuessType {
  LETTER
  WORD
}

enum StopSessionStatus {
  ACTIVE
  FINISHED
  CANCELLED
}

enum StopRoundStatus {
  ANSWERING
  REVIEWING
  FINISHED
}

enum BellHopRunStatus {
  ACTIVE
  FINISHED
  ABANDONED
}

enum TowerStackRunStatus {
  ACTIVE
  FINISHED
  ABANDONED
}

model User {
  id                       String                   @id @default(uuid()) @db.Uuid
  email                    String                   @unique @db.VarChar(320)
  passwordHash             String                   @db.VarChar(255)
  name                     String                   @db.VarChar(80)
  avatarUrl                String?                  @db.Text
  timezone                 String                   @default("America/Sao_Paulo") @db.VarChar(64)
  sessionVersion           Int                      @default(0)
  lastLoginAt              DateTime?                @db.Timestamptz(6)
  createdAt                DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                 @updatedAt @db.Timestamptz(6)
  communitiesCreated       Community[]              @relation("CommunityCreator")
  memberships              CommunityMember[]
  invitesCreated           Invite[]                 @relation("InviteCreator")
  scheduleRules            ScheduleRule[]
  availabilityEntries      AvailabilityOverride[]
  eventsCreated            Event[]                  @relation("EventCreator")
  eventRsvps               EventRsvp[]
  pollsCreated             Poll[]                   @relation("PollCreator")
  pollVotes                PollVote[]
  randomizerRuns           RandomizerRun[]
  holidaysCreated          CommunityHoliday[]       @relation("HolidayCreator")
  costSharesCreated        CostShare[]              @relation("CostShareCreator")
  costShareMemberships     CostShareParticipant[]
  costShareExpensesPaid    CostShareExpense[]       @relation("CostShareExpensePayer")
  costShareExpensesCreated CostShareExpense[]       @relation("CostShareExpenseCreator")
  eventPayments            EventPayment[]           @relation("EventPaymentPerson")
  eventPaymentsRecorded    EventPayment[]           @relation("EventPaymentRecorder")
  eventPaymentsVoided      EventPayment[]           @relation("EventPaymentVoider")
  challengesCreated        Challenge[]              @relation("ChallengeCreator")
  socialPosts              SocialPost[]
  socialComments           SocialComment[]
  socialReactions          SocialReaction[]
  emailSettingsUpdated     CommunityEmailSettings[] @relation("EmailSettingsUpdater")
  emailDeliveriesRequested EmailDelivery[]          @relation("EmailDeliveryRequester")
  gameRoomsCreated         GameRoom[]               @relation("GameRoomCreator")
  bellHopRuns              BellHopRun[]
  towerStackRuns           TowerStackRun[]
  passwordResetTokens      PasswordResetToken[]
}

model RateLimitBucket {
  key       String   @id @db.VarChar(64)
  count     Int      @default(0)
  resetsAt  DateTime @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([resetsAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Community {
  id              String                  @id @default(uuid()) @db.Uuid
  name            String                  @db.VarChar(120)
  slug            String                  @unique @db.VarChar(80)
  description     String?                 @db.Text
  avatarUrl       String?                 @db.Text
  createdById     String                  @db.Uuid
  createdAt       DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @db.Timestamptz(6)
  createdBy       User                    @relation("CommunityCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members         CommunityMember[]
  invites         Invite[]
  schedules       ScheduleRule[]
  availability    AvailabilityOverride[]
  events          Event[]
  polls           Poll[]
  randomizerRuns  RandomizerRun[]
  holidays        CommunityHoliday[]
  costShares      CostShare[]
  challenges      Challenge[]
  socialPosts     SocialPost[]
  emailSettings   CommunityEmailSettings?
  emailDeliveries EmailDelivery[]
  gameRooms       GameRoom[]
  bellHopRuns     BellHopRun[]
  towerStackRuns  TowerStackRun[]

  @@index([createdById])
}

model CommunityEmailSettings {
  communityId               String        @id @db.Uuid
  provider                  EmailProvider @default(GMAIL)
  host                      String        @db.VarChar(255)
  port                      Int
  secure                    Boolean
  username                  String        @db.VarChar(320)
  encryptedPassword         String        @db.Text
  fromName                  String        @db.VarChar(120)
  fromEmail                 String        @db.VarChar(320)
  replyTo                   String?       @db.VarChar(320)
  enabled                   Boolean       @default(false)
  inviteEmailsEnabled       Boolean       @default(true)
  announcementEmailsEnabled Boolean       @default(false)
  lastTestedAt              DateTime?     @db.Timestamptz(6)
  lastTestSucceeded         Boolean?
  lastTestErrorCode         String?       @db.VarChar(80)
  updatedById               String?       @db.Uuid
  createdAt                 DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime      @updatedAt @db.Timestamptz(6)
  community                 Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  updatedBy                 User?         @relation("EmailSettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

model EmailDelivery {
  id             String              @id @default(uuid()) @db.Uuid
  communityId    String              @db.Uuid
  requestedById  String?             @db.Uuid
  socialPostId   String?             @db.Uuid
  kind           String              @db.VarChar(40)
  recipientEmail String              @db.VarChar(320)
  subject        String              @db.VarChar(255)
  status         EmailDeliveryStatus @default(PENDING)
  attemptCount   Int                 @default(0)
  errorCode      String?             @db.VarChar(80)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  sentAt         DateTime?           @db.Timestamptz(6)
  community      Community           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  requestedBy    User?               @relation("EmailDeliveryRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  socialPost     SocialPost?         @relation(fields: [socialPostId], references: [id], onDelete: SetNull)

  @@index([communityId, createdAt, id])
  @@index([requestedById])
  @@index([socialPostId])
}

model SocialPost {
  id              String              @id @default(uuid()) @db.Uuid
  communityId     String              @db.Uuid
  authorId        String              @db.Uuid
  kind            SocialPostKind      @default(POST)
  contentFormat   SocialContentFormat @default(PLAIN_TEXT)
  content         String?             @db.VarChar(5000)
  createdAt       DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(6)
  community       Community           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author          User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media           SocialMedia[]
  comments        SocialComment[]
  reactions       SocialReaction[]
  emailDeliveries EmailDelivery[]

  @@index([communityId, createdAt, id])
  @@index([authorId])
}

model SocialMedia {
  id           String          @id @default(uuid()) @db.Uuid
  postId       String          @db.Uuid
  kind         SocialMediaKind
  contentType  String          @db.VarChar(80)
  originalName String          @db.VarChar(255)
  sizeBytes    Int
  data         Bytes           @db.ByteA
  sortOrder    Int
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  post         SocialPost      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
}

model SocialComment {
  id        String     @id @default(uuid()) @db.Uuid
  postId    String     @db.Uuid
  authorId  String     @db.Uuid
  content   String     @db.VarChar(1000)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt, id])
  @@index([authorId])
}

model SocialReaction {
  postId    String             @db.Uuid
  userId    String             @db.Uuid
  type      SocialReactionType
  createdAt DateTime           @default(now()) @db.Timestamptz(6)
  post      SocialPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

model CommunityMember {
  communityId             String                 @db.Uuid
  userId                  String                 @db.Uuid
  displayName             String?                @db.VarChar(80)
  role                    CommunityRole          @default(MEMBER)
  joinedAt                DateTime               @default(now()) @db.Timestamptz(6)
  community               Community              @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user                    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeParticipations ChallengeParticipant[]
  gameRoomPlayers         GameRoomPlayer[]
  arenaGladiator          ArenaGladiator?

  @@id([communityId, userId])
  @@index([userId])
}

model ArenaGladiator {
  id                 String               @id @default(uuid()) @db.Uuid
  communityId        String               @db.Uuid
  userId             String               @db.Uuid
  name               String               @db.VarChar(40)
  pronouns           String               @db.VarChar(16)
  origin             String               @db.VarChar(32)
  entryLine          String?              @db.VarChar(120)
  victoryLine        String?              @db.VarChar(120)
  appearance         Json
  level              Int                  @default(1)
  experience         Int                  @default(0)
  gold               Int                  @default(500)
  fame               Int                  @default(0)
  unspentSkillPoints Int                  @default(0)
  strength           Int
  agility            Int
  technique          Int
  defence            Int
  vitality           Int
  presence           Int
  stamina            Int
  wins               Int                  @default(0)
  losses             Int                  @default(0)
  createdAt          DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(6)
  member             CommunityMember      @relation(fields: [communityId, userId], references: [communityId, userId], onDelete: Cascade)
  inventory          ArenaInventoryItem[]

  @@unique([communityId, userId])
  @@index([communityId, fame, level, id])
  @@index([userId])
}

model ArenaInventoryItem {
  id             String         @id @default(uuid()) @db.Uuid
  gladiatorId    String         @db.Uuid
  catalogItemKey String         @db.VarChar(80)
  quantity       Int            @default(1)
  equippedSlot   String?        @db.VarChar(32)
  metadata       Json?
  acquiredAt     DateTime       @default(now()) @db.Timestamptz(6)
  gladiator      ArenaGladiator @relation(fields: [gladiatorId], references: [id], onDelete: Cascade)

  @@index([gladiatorId, acquiredAt, id])
  @@index([catalogItemKey])
}

model GameRoom {
  id              String           @id @default(uuid()) @db.Uuid
  communityId     String           @db.Uuid
  createdById     String           @db.Uuid
  gameType        GameType
  name            String           @db.VarChar(80)
  status          GameRoomStatus   @default(WAITING)
  rules           Json
  roundNumber     Int              @default(0)
  version         Int              @default(0)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  community       Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy       User             @relation("GameRoomCreator", fields: [createdById], references: [id], onDelete: Restrict)
  players         GameRoomPlayer[]
  matches         GameMatch[]
  hangmanSessions HangmanSession[]
  stopSessions    StopSession[]

  @@unique([id, communityId])
  @@index([communityId, status, updatedAt, id])
  @@index([createdById])
}

model GameRoomPlayer {
  roomId      String          @db.Uuid
  communityId String          @db.Uuid
  userId      String          @db.Uuid
  seat        Int
  ready       Boolean         @default(false)
  joinedAt    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(6)
  room        GameRoom        @relation(fields: [roomId, communityId], references: [id, communityId], onDelete: Cascade)
  member      CommunityMember @relation(fields: [communityId, userId], references: [communityId, userId], onDelete: Cascade)

  @@id([roomId, userId])
  @@unique([roomId, seat])
  @@index([communityId, userId])
}

model GameMatch {
  id             String            @id @default(uuid()) @db.Uuid
  roomId         String            @db.Uuid
  communityId    String            @db.Uuid
  gameType       GameType
  roundNumber    Int
  status         GameMatchStatus   @default(ACTIVE)
  outcome        GameMatchOutcome?
  board          String            @default("---------") @db.VarChar(9)
  playerXId      String            @db.Uuid
  playerXName    String            @db.VarChar(80)
  playerOId      String            @db.Uuid
  playerOName    String            @db.VarChar(80)
  nextTurnUserId String?           @db.Uuid
  winnerId       String?           @db.Uuid
  winnerName     String?           @db.VarChar(80)
  startedAt      DateTime          @default(now()) @db.Timestamptz(6)
  finishedAt     DateTime?         @db.Timestamptz(6)
  room           GameRoom          @relation(fields: [roomId, communityId], references: [id, communityId], onDelete: Cascade)

  @@unique([roomId, roundNumber])
  @@index([communityId, gameType, finishedAt, id])
  @@index([roomId, status, startedAt])
  @@index([winnerId, finishedAt])
}

model HangmanSession {
  id                 String                 @id @default(uuid()) @db.Uuid
  roomId             String                 @db.Uuid
  communityId        String                 @db.Uuid
  status             HangmanSessionStatus   @default(ACTIVE)
  totalRounds        Int
  currentRoundNumber Int                    @default(1)
  startedAt          DateTime               @default(now()) @db.Timestamptz(6)
  finishedAt         DateTime?              @db.Timestamptz(6)
  cancelledAt        DateTime?              @db.Timestamptz(6)
  cancellationReason String?                @db.VarChar(160)
  room               GameRoom               @relation(fields: [roomId, communityId], references: [id, communityId], onDelete: Cascade)
  players            HangmanSessionPlayer[]
  rounds             HangmanRound[]

  @@unique([id, communityId])
  @@index([communityId, status, finishedAt, id])
  @@index([roomId, status, startedAt])
}

model HangmanSessionPlayer {
  sessionId String         @db.Uuid
  userId    String         @db.Uuid
  name      String         @db.VarChar(80)
  turnOrder Int
  score     Int            @default(0)
  session   HangmanSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, userId])
  @@unique([sessionId, turnOrder])
  @@index([userId])
}

model HangmanRound {
  id                String               @id @default(uuid()) @db.Uuid
  sessionId         String               @db.Uuid
  roundNumber       Int
  setterId          String               @db.Uuid
  setterName        String               @db.VarChar(80)
  status            HangmanRoundStatus   @default(SETTING_WORD)
  outcome           HangmanRoundOutcome?
  secretWord        String?              @db.VarChar(80)
  normalizedWord    String?              @db.VarChar(80)
  clue              String?              @db.VarChar(160)
  guessedLetters    String               @default("") @db.VarChar(32)
  wrongCount        Int                  @default(0)
  currentTurnUserId String?              @db.Uuid
  winnerId          String?              @db.Uuid
  winnerName        String?              @db.VarChar(80)
  startedAt         DateTime             @default(now()) @db.Timestamptz(6)
  wordSetAt         DateTime?            @db.Timestamptz(6)
  finishedAt        DateTime?            @db.Timestamptz(6)
  session           HangmanSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  guesses           HangmanGuess[]

  @@unique([sessionId, roundNumber])
  @@index([sessionId, status, roundNumber])
  @@index([winnerId, finishedAt])
}

model HangmanGuess {
  id              String           @id @default(uuid()) @db.Uuid
  roundId         String           @db.Uuid
  userId          String           @db.Uuid
  userName        String           @db.VarChar(80)
  type            HangmanGuessType
  value           String           @db.VarChar(80)
  normalizedValue String           @db.VarChar(80)
  correct         Boolean
  turnNumber      Int
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  round           HangmanRound     @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, turnNumber])
  @@index([roundId, createdAt, id])
  @@index([userId])
}

model StopSession {
  id                 String              @id @default(uuid()) @db.Uuid
  roomId             String              @db.Uuid
  communityId        String              @db.Uuid
  status             StopSessionStatus   @default(ACTIVE)
  totalRounds        Int
  answerSeconds      Int
  currentRoundNumber Int                 @default(1)
  startedAt          DateTime            @default(now()) @db.Timestamptz(6)
  finishedAt         DateTime?           @db.Timestamptz(6)
  cancelledAt        DateTime?           @db.Timestamptz(6)
  cancellationReason String?             @db.VarChar(160)
  room               GameRoom            @relation(fields: [roomId, communityId], references: [id, communityId], onDelete: Cascade)
  players            StopSessionPlayer[]
  categories         StopCategory[]
  rounds             StopRound[]

  @@unique([id, communityId])
  @@index([communityId, status, finishedAt, id])
  @@index([roomId, status, startedAt])
}

model StopSessionPlayer {
  sessionId String      @db.Uuid
  userId    String      @db.Uuid
  name      String      @db.VarChar(80)
  seat      Int
  score     Int         @default(0)
  session   StopSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, userId])
  @@unique([sessionId, seat])
  @@index([userId])
}

model StopCategory {
  id        String       @id @default(uuid()) @db.Uuid
  sessionId String       @db.Uuid
  name      String       @db.VarChar(60)
  sortOrder Int
  session   StopSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers   StopAnswer[]

  @@unique([sessionId, sortOrder])
  @@index([sessionId, id])
}

model StopRound {
  id                  String          @id @default(uuid()) @db.Uuid
  sessionId           String          @db.Uuid
  roundNumber         Int
  letter              String          @db.Char(1)
  status              StopRoundStatus @default(ANSWERING)
  reviewCategoryIndex Int             @default(0)
  answerDeadline      DateTime        @db.Timestamptz(6)
  bonusDeadline       DateTime        @db.Timestamptz(6)
  stoppedById         String?         @db.Uuid
  stoppedByName       String?         @db.VarChar(80)
  stoppedAt           DateTime?       @db.Timestamptz(6)
  startedAt           DateTime        @default(now()) @db.Timestamptz(6)
  reviewStartedAt     DateTime?       @db.Timestamptz(6)
  reviewDeadline      DateTime?       @db.Timestamptz(6)
  finishedAt          DateTime?       @db.Timestamptz(6)
  session             StopSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers             StopAnswer[]

  @@unique([sessionId, roundNumber])
  @@index([sessionId, status, roundNumber])
}

model StopAnswer {
  id              String            @id @default(uuid()) @db.Uuid
  roundId         String            @db.Uuid
  categoryId      String            @db.Uuid
  userId          String            @db.Uuid
  userName        String            @db.VarChar(80)
  value           String            @db.VarChar(80)
  normalizedValue String            @db.VarChar(80)
  finalValid      Boolean?
  awardedPoints   Int?
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6)
  round           StopRound         @relation(fields: [roundId], references: [id], onDelete: Cascade)
  category        StopCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  invalidVotes    StopInvalidVote[]

  @@unique([roundId, categoryId, userId])
  @@index([roundId, categoryId])
  @@index([userId])
}

model StopInvalidVote {
  answerId  String     @db.Uuid
  voterId   String     @db.Uuid
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  answer    StopAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@id([answerId, voterId])
  @@index([voterId])
}

model BellHopRun {
  id          String           @id @default(uuid()) @db.Uuid
  communityId String           @db.Uuid
  userId      String           @db.Uuid
  playerName  String           @db.VarChar(80)
  status      BellHopRunStatus @default(ACTIVE)
  seed        Int
  score       Int?
  bellsHit    Int?
  maxHeight   Int?
  durationMs  Int?
  startedAt   DateTime         @default(now()) @db.Timestamptz(6)
  finishedAt  DateTime?        @db.Timestamptz(6)
  community   Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([communityId, status, finishedAt, score, id])
  @@index([communityId, userId, startedAt])
  @@index([userId])
}

model TowerStackRun {
  id             String              @id @default(uuid()) @db.Uuid
  communityId    String              @db.Uuid
  userId         String              @db.Uuid
  playerName     String              @db.VarChar(80)
  status         TowerStackRunStatus @default(ACTIVE)
  seed           Int
  score          Int?
  blocksPlaced   Int?
  maxHeight      Int?
  livesRemaining Int?
  durationMs     Int?
  startedAt      DateTime            @default(now()) @db.Timestamptz(6)
  finishedAt     DateTime?           @db.Timestamptz(6)
  community      Community           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([communityId, status, finishedAt, score, id])
  @@index([communityId, userId, startedAt])
  @@index([userId])
}

model Challenge {
  id              String                 @id @default(uuid()) @db.Uuid
  communityId     String                 @db.Uuid
  createdById     String                 @db.Uuid
  title           String                 @db.VarChar(160)
  description     String?                @db.Text
  rules           String                 @db.Text
  startDate       DateTime               @db.Date
  endDate         DateTime               @db.Date
  timezone        String                 @db.VarChar(64)
  configuration   Json
  firstJoinedAt   DateTime?              @db.Timestamptz(6)
  cancelledAt     DateTime?              @db.Timestamptz(6)
  finalizedAt     DateTime?              @db.Timestamptz(6)
  finalizedByName String?                @db.VarChar(160)
  createdAt       DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(6)
  community       Community              @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy       User                   @relation("ChallengeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  participants    ChallengeParticipant[]
  results         ChallengeResult[]
  auditLogs       ChallengeAuditLog[]

  @@unique([id, communityId])
  @@index([communityId, createdAt, id])
  @@index([createdById])
}

model ChallengeParticipant {
  challengeId String              @db.Uuid
  communityId String              @db.Uuid
  userId      String              @db.Uuid
  joinedAt    DateTime            @default(now()) @db.Timestamptz(6)
  leftAt      DateTime?           @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(6)
  challenge   Challenge           @relation(fields: [challengeId, communityId], references: [id, communityId], onDelete: Cascade)
  member      CommunityMember     @relation(fields: [communityId, userId], references: [communityId, userId], onDelete: Cascade)
  activities  ChallengeActivity[]

  @@id([challengeId, userId])
  @@index([communityId, userId])
  @@index([challengeId, leftAt, joinedAt, userId])
}

model ChallengeActivity {
  id                String                   @id @default(uuid()) @db.Uuid
  challengeId       String                   @db.Uuid
  userId            String                   @db.Uuid
  clientRequestId   String                   @db.Uuid
  requestHash       String                   @db.VarChar(64)
  title             String                   @db.VarChar(160)
  notes             String?                  @db.VarChar(2000)
  activityType      String                   @db.VarChar(32)
  performedOn       DateTime                 @db.Date
  durationSeconds   Int
  distanceMeters    Int?
  score             Decimal                  @db.Decimal(18, 1)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(6)
  deletedAt         DateTime?                @db.Timestamptz(6)
  invalidatedAt     DateTime?                @db.Timestamptz(6)
  moderationReason  String?                  @db.VarChar(1000)
  moderationVersion Int                      @default(0)
  participant       ChallengeParticipant     @relation(fields: [challengeId, userId], references: [challengeId, userId], onDelete: Cascade)
  photos            ChallengeActivityPhoto[]

  @@unique([challengeId, userId, clientRequestId])
  @@index([challengeId, deletedAt, createdAt, id])
  @@index([challengeId, userId, performedOn, deletedAt])
}

model ChallengeActivityPhoto {
  id         String            @id @default(uuid()) @db.Uuid
  activityId String            @db.Uuid
  data       Bytes             @db.ByteA
  sortOrder  Int
  createdAt  DateTime          @default(now()) @db.Timestamptz(6)
  activity   ChallengeActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, sortOrder])
}

// Snapshots deliberately do not reference membership/user/activity: community history survives departures.
model ChallengeResult {
  challengeId   String    @db.Uuid
  userId        String    @db.Uuid
  name          String    @db.VarChar(160)
  score         Decimal   @db.Decimal(18, 1)
  activityCount Int
  position      Int?
  challenge     Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@id([challengeId, userId])
  @@index([challengeId, score, name, userId])
}

enum ChallengeAuditAction {
  INVALIDATE
  RESTORE
  REMOVE
  FINALIZE
}

model ChallengeAuditLog {
  id              String               @id @default(uuid()) @db.Uuid
  challengeId     String               @db.Uuid
  actorId         String               @db.Uuid
  actorName       String               @db.VarChar(160)
  action          ChallengeAuditAction
  activityId      String?              @db.Uuid
  activityTitle   String?              @db.VarChar(160)
  participantName String?              @db.VarChar(160)
  reason          String               @db.VarChar(1000)
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  challenge       Challenge            @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId, createdAt, id])
}

model Invite {
  id          String       @id @default(uuid()) @db.Uuid
  communityId String       @db.Uuid
  tokenHash   String       @unique @db.VarChar(128)
  createdById String       @db.Uuid
  expiresAt   DateTime?    @db.Timestamptz(6)
  maxUses     Int?
  useCount    Int          @default(0)
  revokedAt   DateTime?    @db.Timestamptz(6)
  status      InviteStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  community   Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([communityId])
}

model ScheduleRule {
  id              String             @id @default(uuid()) @db.Uuid
  communityId     String             @db.Uuid
  userId          String             @db.Uuid
  name            String             @db.VarChar(120)
  ruleType        ScheduleRuleType
  anchorDate      DateTime?          @db.Date
  workDays        Int?
  restDays        Int?
  weeklyPattern   Json?
  workStartMinute Int?
  workEndMinute   Int?
  startDate       DateTime           @db.Date
  endDate         DateTime?          @db.Date
  status          ScheduleRuleStatus @default(ACTIVE)
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(6)
  community       Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([communityId, startDate])
  @@index([userId, startDate])
  @@index([communityId, userId, status, startDate])
}

model AvailabilityOverride {
  id          String             @id @default(uuid()) @db.Uuid
  communityId String             @db.Uuid
  userId      String             @db.Uuid
  startAt     DateTime           @db.Timestamptz(6)
  endAt       DateTime           @db.Timestamptz(6)
  allDay      Boolean            @default(false)
  status      AvailabilityStatus
  note        String?            @db.Text
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(6)
  community   Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([communityId, startAt])
  @@index([userId, startAt])
  @@index([communityId, userId, startAt, endAt])
}

model Event {
  id                     String         @id @default(uuid()) @db.Uuid
  communityId            String         @db.Uuid
  createdById            String         @db.Uuid
  title                  String         @db.VarChar(160)
  description            String?        @db.Text
  startsAt               DateTime       @db.Timestamptz(6)
  endsAt                 DateTime?      @db.Timestamptz(6)
  allDay                 Boolean        @default(false)
  timezone               String         @default("America/Sao_Paulo") @db.VarChar(64)
  locationName           String?        @db.VarChar(160)
  locationAddress        String?        @db.Text
  locationUrl            String?        @db.Text
  estimatedCost          Decimal?       @db.Decimal(10, 2)
  currency               String         @default("BRL") @db.Char(3)
  participantLimit       Int?
  allowMaybe             Boolean        @default(true)
  allowPartialAttendance Boolean        @default(false)
  status                 EventStatus    @default(PUBLISHED)
  createdAt              DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @db.Timestamptz(6)
  community              Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy              User           @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  rsvps                  EventRsvp[]
  costShares             CostShare[]
  paymentTrackingEnabled Boolean        @default(false)
  accountClosedAt        DateTime?      @db.Timestamptz(6)
  accountSnapshot        Json?
  payments               EventPayment[]

  @@index([communityId, startsAt])
  @@index([communityId, status, startsAt])
}

model EventPayment {
  id           String    @id @default(uuid()) @db.Uuid
  eventId      String    @db.Uuid
  userId       String    @db.Uuid
  recordedById String    @db.Uuid
  amountCents  BigInt
  direction    String    @db.VarChar(8)
  note         String?   @db.VarChar(500)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  voidedAt     DateTime? @db.Timestamptz(6)
  voidedById   String?   @db.Uuid
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User      @relation("EventPaymentPerson", fields: [userId], references: [id], onDelete: Restrict)
  recordedBy   User      @relation("EventPaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  voidedBy     User?     @relation("EventPaymentVoider", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([eventId, createdAt])
  @@index([userId])
  @@index([recordedById])
  @@index([voidedById])
}

model EventRsvp {
  eventId               String         @db.Uuid
  userId                String         @db.Uuid
  status                RsvpStatus
  attendingSpecificDays Boolean        @default(false)
  createdAt             DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @db.Timestamptz(6)
  event                 Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendanceDays        EventRsvpDay[]

  @@id([eventId, userId])
  @@index([userId])
}

model EventRsvpDay {
  eventId String    @db.Uuid
  userId  String    @db.Uuid
  date    DateTime  @db.Date
  rsvp    EventRsvp @relation(fields: [eventId, userId], references: [eventId, userId], onDelete: Cascade)

  @@id([eventId, userId, date])
  @@index([eventId, date])
}

model CommunityHoliday {
  id          String    @id @default(uuid()) @db.Uuid
  communityId String    @db.Uuid
  createdById String    @db.Uuid
  name        String    @db.VarChar(120)
  date        DateTime  @db.Date
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("HolidayCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([communityId, date, name])
  @@index([communityId, date])
}

model CostShare {
  id           String                 @id @default(uuid()) @db.Uuid
  communityId  String                 @db.Uuid
  eventId      String?                @db.Uuid
  createdById  String                 @db.Uuid
  title        String                 @db.VarChar(160)
  description  String?                @db.Text
  currency     String                 @default("BRL") @db.Char(3)
  status       CostShareStatus        @default(OPEN)
  createdAt    DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime               @updatedAt @db.Timestamptz(6)
  community    Community              @relation(fields: [communityId], references: [id], onDelete: Cascade)
  event        Event?                 @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdBy    User                   @relation("CostShareCreator", fields: [createdById], references: [id], onDelete: Restrict)
  participants CostShareParticipant[]
  expenses     CostShareExpense[]

  @@index([communityId, createdAt])
  @@index([eventId])
  @@index([createdById])
}

model CostShareParticipant {
  costShareId String    @db.Uuid
  userId      String    @db.Uuid
  joinedAt    DateTime  @default(now()) @db.Timestamptz(6)
  costShare   CostShare @relation(fields: [costShareId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([costShareId, userId])
  @@index([userId])
}

model CostShareExpense {
  id          String    @id @default(uuid()) @db.Uuid
  costShareId String    @db.Uuid
  payerId     String    @db.Uuid
  createdById String    @db.Uuid
  description String    @db.VarChar(200)
  amount      Decimal   @db.Decimal(10, 2)
  purchasedAt DateTime  @db.Date
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  costShare   CostShare @relation(fields: [costShareId], references: [id], onDelete: Cascade)
  payer       User      @relation("CostShareExpensePayer", fields: [payerId], references: [id], onDelete: Restrict)
  createdBy   User      @relation("CostShareExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([costShareId, purchasedAt])
  @@index([payerId])
  @@index([createdById])
}

model Poll {
  id              String       @id @default(uuid()) @db.Uuid
  communityId     String       @db.Uuid
  createdById     String       @db.Uuid
  title           String       @db.VarChar(160)
  description     String?      @db.Text
  type            PollType
  allowVoteChange Boolean      @default(true)
  closesAt        DateTime?    @db.Timestamptz(6)
  status          PollStatus   @default(OPEN)
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)
  community       Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy       User         @relation("PollCreator", fields: [createdById], references: [id], onDelete: Restrict)
  options         PollOption[]
  votes           PollVote[]

  @@index([communityId, status])
  @@index([communityId, status, closesAt])
}

model PollOption {
  id        String            @id @default(uuid()) @db.Uuid
  pollId    String            @db.Uuid
  label     String            @db.VarChar(160)
  sortOrder Int               @default(0)
  dateValue DateTime?         @db.Date
  metadata  Json?
  poll      Poll              @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     PollVote[]
  images    PollOptionImage[]

  @@index([pollId, sortOrder])
}

model PollOptionImage {
  id           String     @id @default(uuid()) @db.Uuid
  optionId     String     @db.Uuid
  data         Bytes      @db.ByteA
  contentType  String     @db.VarChar(32)
  originalName String     @db.VarChar(255)
  sizeBytes    Int
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  option       PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([optionId, sortOrder])
}

model PollVote {
  id        String     @id @default(uuid()) @db.Uuid
  pollId    String     @db.Uuid
  optionId  String     @db.Uuid
  userId    String     @db.Uuid
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([pollId, userId])
  @@index([pollId, optionId])
}

model RandomizerRun {
  id            String               @id @default(uuid()) @db.Uuid
  communityId   String               @db.Uuid
  createdById   String               @db.Uuid
  presetType    RandomizerPresetType
  title         String?              @db.VarChar(160)
  configuration Json
  inputSnapshot Json
  result        Json
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  community     Community            @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy     User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([communityId, createdAt])
  @@index([createdById])
}
