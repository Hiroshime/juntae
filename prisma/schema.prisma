}

model CostShareExpense {
  id          String    @id @default(uuid()) @db.Uuid
  costShareId String    @db.Uuid
  payerId     String    @db.Uuid
  createdById String    @db.Uuid
  description String    @db.VarChar(200)
  amount      Decimal   @db.Decimal(10, 2)
  purchasedAt DateTime  @db.Date
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  costShare   CostShare @relation(fields: [costShareId], references: [id], onDelete: Cascade)
  payer       User      @relation("CostShareExpensePayer", fields: [payerId], references: [id], onDelete: Restrict)
  createdBy   User      @relation("CostShareExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([costShareId, purchasedAt])
  @@index([payerId])
  @@index([createdById])
}

model CommunityFundSettings {
  communityId              String    @id @db.Uuid
  monthlyContributionCents BigInt?
  pixKey                   String?   @db.VarChar(320)
  pixRecipientName         String?   @db.VarChar(120)
  pixCopyPaste             String?   @db.Text
  qrCodeContentType        String?   @db.VarChar(80)
  qrCodeData               Bytes?    @db.ByteA
  updatedById              String?   @db.Uuid
  createdAt                DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @db.Timestamptz(6)
  community                Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  updatedBy                User?     @relation("CommunityFundSettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

model CommunityFundEntry {
  id             String                   @id @default(uuid()) @db.Uuid
  communityId    String                   @db.Uuid
  userId         String                   @db.Uuid
  submittedById  String                   @db.Uuid
  reviewedById   String?                  @db.Uuid
  eventId        String?                  @db.Uuid
  type           CommunityFundEntryType
  status         CommunityFundEntryStatus @default(PENDING)
  amountCents    BigInt
  referenceMonth DateTime?                @db.Date
  effectiveDate  DateTime                 @db.Date
  note           String?                  @db.VarChar(500)
  reviewNote     String?                  @db.VarChar(500)
  reviewedAt     DateTime?                @db.Timestamptz(6)
  createdAt      DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(6)
  community      Community                @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user           User                     @relation("CommunityFundEntryPerson", fields: [userId], references: [id], onDelete: Restrict)
  submittedBy    User                     @relation("CommunityFundEntrySubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy     User?                    @relation("CommunityFundEntryReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  event          Event?                   @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([communityId, status, createdAt, id])
  @@index([communityId, userId, createdAt, id])
  @@index([eventId])
  @@index([submittedById])
  @@index([reviewedById])
}

model Poll {
  id                 String         @id @default(uuid()) @db.Uuid
  communityId        String         @db.Uuid
  eventId            String?        @db.Uuid
  createdById        String         @db.Uuid
  title              String         @db.VarChar(160)
  description        String?        @db.Text
  type               PollType
  allowVoteChange    Boolean        @default(true)
  allowMemberOptions Boolean        @default(false)
  timezone           String         @default("America/Sao_Paulo") @db.VarChar(64)
  closesAt           DateTime?      @db.Timestamptz(6)
  closedAt           DateTime?      @db.Timestamptz(6)
  status             PollStatus     @default(OPEN)
  createdAt          DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(6)
  community          Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  event              Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdBy          User           @relation("PollCreator", fields: [createdById], references: [id], onDelete: Restrict)
  options            PollOption[]
  questions          PollQuestion[]
  votes              PollVote[]

  @@index([communityId, status])
  @@index([communityId, status, closesAt])
  @@index([eventId])
}

model PollQuestion {
  id        String           @id @default(uuid()) @db.Uuid
  pollId    String           @db.Uuid
  title     String           @db.VarChar(160)
  type      PollQuestionType
  sortOrder Int              @default(0)
  poll      Poll             @relation(fields: [pollId], references: [id], onDelete: Cascade)
  options   PollOption[]

  @@unique([id, pollId])
  @@index([pollId, sortOrder])
}

model PollOption {
  id         String            @id @default(uuid()) @db.Uuid
  pollId     String            @db.Uuid
  questionId String?           @db.Uuid
  label      String            @db.VarChar(160)
  sortOrder  Int               @default(0)
  dateValue  DateTime?         @db.Date
  metadata   Json?
  poll       Poll              @relation(fields: [pollId], references: [id], onDelete: Cascade)
  question   PollQuestion?     @relation(fields: [questionId, pollId], references: [id, pollId], onDelete: Cascade)
  votes      PollVote[]
  images     PollOptionImage[]

  @@index([pollId, sortOrder])
  @@index([questionId, pollId])
}

model PollOptionImage {
  id           String     @id @default(uuid()) @db.Uuid
  optionId     String     @db.Uuid
  data         Bytes      @db.ByteA
  contentType  String     @db.VarChar(32)
  originalName String     @db.VarChar(255)
  sizeBytes    Int
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  option       PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([optionId, sortOrder])
}

model PollVote {
  id        String     @id @default(uuid()) @db.Uuid
  pollId    String     @db.Uuid
  optionId  String     @db.Uuid
  userId    String     @db.Uuid
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([pollId, userId])
  @@index([pollId, optionId])
}

model RandomizerRun {
  id            String               @id @default(uuid()) @db.Uuid
  communityId   String               @db.Uuid
  createdById   String               @db.Uuid
  presetType    RandomizerPresetType
  title         String?              @db.VarChar(160)
  configuration Json
  inputSnapshot Json
  result        Json
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  community     Community            @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy     User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([communityId, createdAt])
  @@index([createdById])
}
