generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CommunityRole {
  OWNER
  ADMIN
  MEMBER
}

enum InviteStatus {
  ACTIVE
  REVOKED
}

enum ScheduleRuleType {
  WEEKLY
  CYCLE
}

enum ScheduleRuleStatus {
  ACTIVE
  INACTIVE
}

enum AvailabilityStatus {
  AVAILABLE
  PARTIALLY_AVAILABLE
  WORKING
  DAY_OFF
  VACATION
  UNAVAILABLE
  UNKNOWN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum RsvpStatus {
  GOING
  MAYBE
  NOT_GOING
}

enum PollType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  DATE_OPTIONS
  GROUPED
}

enum PollQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum PollStatus {
  OPEN
  CLOSED
}

enum RandomizerPresetType {
  TEAMS
  GROUPS
  CARS
  ASSIGN_ITEMS
  PICK_PEOPLE
  PICK_ITEM
  RANDOM_ORDER
  PAIRS
}

enum CostShareStatus {
  OPEN
  CLOSED
}

enum EventBillingMode {
  EQUAL
  DAY
  NIGHT
}

enum CostShareAllocation {
  SELECTED
  EVENT
  DAY
}

enum CommunityFundEntryType {
  DEPOSIT
  USAGE
}

enum CommunityFundEntryStatus {
  PENDING
  APPROVED
  REJECTED
  VOIDED
}

enum SocialPostKind {
  POST
  ANNOUNCEMENT
}

enum SocialContentFormat {
  PLAIN_TEXT
  MARKDOWN
}

enum SocialMediaKind {
  IMAGE
  VIDEO
}

enum SocialReactionType {
  LIKE
  LOVE
  CELEBRATE
  LAUGH
  SUPPORT
}

enum EmailProvider {
  GMAIL
  CUSTOM_SMTP
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum AiMessageRole {
  USER
  ASSISTANT
}

enum GameType {
  TIC_TAC_TOE
  HANGMAN
  STOP
}

enum GameRoomStatus {
  WAITING
  PLAYING
  CLOSED
}

enum GameMatchStatus {
  ACTIVE
  FINISHED
}

enum GameMatchOutcome {
  X_WON
  O_WON
  DRAW
  X_WON_FORFEIT
  O_WON_FORFEIT
}

enum HangmanSessionStatus {
  ACTIVE
  FINISHED
  CANCELLED
}

enum HangmanRoundStatus {
  SETTING_WORD
  GUESSING
  FINISHED
}

enum HangmanRoundOutcome {
  GUESSED
  HANGED
  CANCELLED
}

enum HangmanGuessType {
  LETTER
  WORD
}

enum StopSessionStatus {
  ACTIVE
  FINISHED
  CANCELLED
}

enum StopRoundStatus {
  ANSWERING
  REVIEWING
  FINISHED
}

enum BellHopRunStatus {
  ACTIVE
  FINISHED
  ABANDONED
}

enum TowerStackRunStatus {
  ACTIVE
  FINISHED
  ABANDONED
}

enum ArenaBattleStatus {
  ACTIVE
  WON
  LOST
  ABANDONED
}

enum ArenaBattleAction {
  ADVANCE
  RETREAT
  QUICK_STRIKE
  POWER_STRIKE
  GUARD
  RECOVER
}

enum ArenaBattleActor {
  PLAYER
  OPPONENT
}

enum ArenaOccupationKind {
  TRAINING
  MISSION
}

enum ArenaOccupationStatus {
  ACTIVE
  COMPLETED
}

enum ArenaIncidentKind {
  ROBBED
  BRUISED
  EXHAUSTED
}

enum ArenaPvpRaidStatus {
  ACTIVE
  ATTACKER_WON
  DEFENDER_WON
}

model User {
  id                       String                   @id @default(uuid()) @db.Uuid
  email                    String                   @unique @db.VarChar(320)
  passwordHash             String                   @db.VarChar(255)
  name                     String                   @db.VarChar(80)
  avatarUrl                String?                  @db.Text
  timezone                 String                   @default("America/Sao_Paulo") @db.VarChar(64)
  sessionVersion           Int                      @default(0)
  lastLoginAt              DateTime?                @db.Timestamptz(6)
  createdAt                DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                 @updatedAt @db.Timestamptz(6)
  communitiesCreated       Community[]              @relation("CommunityCreator")
  memberships              CommunityMember[]
  invitesCreated           Invite[]                 @relation("InviteCreator")
  scheduleRules            ScheduleRule[]
  availabilityEntries      AvailabilityOverride[]
  eventsCreated            Event[]                  @relation("EventCreator")
  eventRsvps               EventRsvp[]
  pollsCreated             Poll[]                   @relation("PollCreator")
  pollVotes                PollVote[]
  randomizerRuns           RandomizerRun[]
  holidaysCreated          CommunityHoliday[]       @relation("HolidayCreator")
  costSharesCreated        CostShare[]              @relation("CostShareCreator")
  costShareMemberships     CostShareParticipant[]
  costShareExpensesPaid    CostShareExpense[]       @relation("CostShareExpensePayer")
  costShareExpensesCreated CostShareExpense[]       @relation("CostShareExpenseCreator")
  eventPayments            EventPayment[]           @relation("EventPaymentPerson")
  eventPaymentsRecorded    EventPayment[]           @relation("EventPaymentRecorder")
  eventPaymentsVoided      EventPayment[]           @relation("EventPaymentVoider")
  challengesCreated        Challenge[]              @relation("ChallengeCreator")
  socialPosts              SocialPost[]
  socialComments           SocialComment[]
  socialReactions          SocialReaction[]
  emailSettingsUpdated     CommunityEmailSettings[] @relation("EmailSettingsUpdater")
  emailDeliveriesRequested EmailDelivery[]          @relation("EmailDeliveryRequester")
  gameRoomsCreated         GameRoom[]               @relation("GameRoomCreator")
  bellHopRuns              BellHopRun[]
  towerStackRuns           TowerStackRun[]
  passwordResetTokens      PasswordResetToken[]
  voiceChannelsCreated     VoiceChannel[]           @relation("VoiceChannelCreator")
  communityFundEntries     CommunityFundEntry[]     @relation("CommunityFundEntryPerson")
  fundEntriesSubmitted     CommunityFundEntry[]     @relation("CommunityFundEntrySubmitter")
  fundEntriesReviewed      CommunityFundEntry[]     @relation("CommunityFundEntryReviewer")
  fundSettingsUpdated      CommunityFundSettings[]  @relation("CommunityFundSettingsUpdater")
  aiSettingsUpdated        CommunityAiSettings[]    @relation("CommunityAiSettingsUpdater")
  aiConversations          AiConversation[]
  packingListsCreated      PackingList[]            @relation("PackingListCreator")
  packingItemsCreated      PackingItem[]            @relation("PackingItemCreator")
  packingItemsAssigned     PackingItem[]            @relation("PackingItemResponsible")
}

model RateLimitBucket {
  key       String   @id @db.VarChar(64)
  count     Int      @default(0)
  resetsAt  DateTime @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([resetsAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Community {
  id              String                  @id @default(uuid()) @db.Uuid
  name            String                  @db.VarChar(120)
  slug            String                  @unique @db.VarChar(80)
  description     String?                 @db.Text
  avatarUrl       String?                 @db.Text
  createdById     String                  @db.Uuid
  createdAt       DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @db.Timestamptz(6)
  createdBy       User                    @relation("CommunityCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members         CommunityMember[]
  invites         Invite[]
  schedules       ScheduleRule[]
  availability    AvailabilityOverride[]
  events          Event[]
  polls           Poll[]
  randomizerRuns  RandomizerRun[]
  holidays        CommunityHoliday[]
  costShares      CostShare[]
  challenges      Challenge[]
  socialPosts     SocialPost[]
  emailSettings   CommunityEmailSettings?
  emailDeliveries EmailDelivery[]
  gameRooms       GameRoom[]
  bellHopRuns     BellHopRun[]
  towerStackRuns  TowerStackRun[]
  voiceChannels   VoiceChannel[]
  fundSettings    CommunityFundSettings?
  fundEntries     CommunityFundEntry[]
  aiSettings      CommunityAiSettings?
  aiConversations AiConversation[]
  packingLists    PackingList[]

  @@index([createdById])
}

model CommunityAiSettings {
  communityId          String    @id @db.Uuid
  enabled              Boolean   @default(false)
  model                String    @default("qwen3:1.7b") @db.VarChar(120)
  assistantName        String    @default("Juntaê IA") @db.VarChar(60)
  customInstructions   String?   @db.VarChar(1000)
  includeEvents        Boolean   @default(true)
  includeAvailability  Boolean   @default(true)
  includePolls         Boolean   @default(true)
  includeAnnouncements Boolean   @default(true)
  includeChallenges    Boolean   @default(true)
  updatedById          String?   @db.Uuid
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(6)
  community            Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  updatedBy            User?     @relation("CommunityAiSettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

model AiConversation {
  id          String      @id @default(uuid()) @db.Uuid
  communityId String      @db.Uuid
  userId      String      @db.Uuid
  title       String      @db.VarChar(120)
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(6)
  community   Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    AiMessage[]

  @@index([communityId, userId, updatedAt])
}

model AiMessage {
  id               String         @id @default(uuid()) @db.Uuid
  conversationId   String         @db.Uuid
  sequence         Int
  role             AiMessageRole
  content          String         @db.Text
  model            String?        @db.VarChar(120)
  promptTokens     Int?
  completionTokens Int?
  durationMs       Int?
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  conversation     AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, sequence])
  @@index([conversationId, createdAt, id])
}

model CommunityEmailSettings {
  communityId               String        @id @db.Uuid
  provider                  EmailProvider @default(GMAIL)
  host                      String        @db.VarChar(255)
  port                      Int
  secure                    Boolean
  username                  String        @db.VarChar(320)
  encryptedPassword         String        @db.Text
  fromName                  String        @db.VarChar(120)
  fromEmail                 String        @db.VarChar(320)
  replyTo                   String?       @db.VarChar(320)
  enabled                   Boolean       @default(false)
  inviteEmailsEnabled       Boolean       @default(true)
  announcementEmailsEnabled Boolean       @default(false)
  lastTestedAt              DateTime?     @db.Timestamptz(6)
  lastTestSucceeded         Boolean?
  lastTestErrorCode         String?       @db.VarChar(80)
  updatedById               String?       @db.Uuid
  createdAt                 DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime      @updatedAt @db.Timestamptz(6)
  community                 Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  updatedBy                 User?         @relation("EmailSettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

model EmailDelivery {
  id             String              @id @default(uuid()) @db.Uuid
  communityId    String              @db.Uuid
  requestedById  String?             @db.Uuid
  socialPostId   String?             @db.Uuid
  kind           String              @db.VarChar(40)
  recipientEmail String              @db.VarChar(320)
  subject        String              @db.VarChar(255)
  status         EmailDeliveryStatus @default(PENDING)
  attemptCount   Int                 @default(0)
  errorCode      String?             @db.VarChar(80)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  sentAt         DateTime?           @db.Timestamptz(6)
  community      Community           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  requestedBy    User?               @relation("EmailDeliveryRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  socialPost     SocialPost?         @relation(fields: [socialPostId], references: [id], onDelete: SetNull)

  @@index([communityId, createdAt, id])
  @@index([requestedById])
  @@index([socialPostId])
}

model SocialPost {
  id              String              @id @default(uuid()) @db.Uuid
  communityId     String              @db.Uuid
  authorId        String              @db.Uuid
  kind            SocialPostKind      @default(POST)
  contentFormat   SocialContentFormat @default(PLAIN_TEXT)
  content         String?             @db.VarChar(5000)
  createdAt       DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(6)
  community       Community           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author          User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media           SocialMedia[]
  comments        SocialComment[]
  reactions       SocialReaction[]
  emailDeliveries EmailDelivery[]

  @@index([communityId, createdAt, id])
  @@index([authorId])
}

model SocialMedia {
  id           String          @id @default(uuid()) @db.Uuid
  postId       String          @db.Uuid
  kind         SocialMediaKind
  contentType  String          @db.VarChar(80)
  originalName String          @db.VarChar(255)
  sizeBytes    Int
  data         Bytes           @db.ByteA
  sortOrder    Int
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  post         SocialPost      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
}

model SocialComment {
  id        String     @id @default(uuid()) @db.Uuid
  postId    String     @db.Uuid
  authorId  String     @db.Uuid
  content   String     @db.VarChar(1000)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt, id])
  @@index([authorId])
}

model SocialReaction {
  postId    String             @db.Uuid
  userId    String             @db.Uuid
  type      SocialReactionType
  createdAt DateTime           @default(now()) @db.Timestamptz(6)
  post      SocialPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

model VoiceChannel {
  id              String    @id @default(uuid()) @db.Uuid
  communityId     String    @db.Uuid
  createdById     String    @db.Uuid
  name            String    @db.VarChar(60)
  nameKey         String    @db.VarChar(60)
  description     String?   @db.VarChar(160)
  maxParticipants Int       @default(12)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  community       Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy       User      @relation("VoiceChannelCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([communityId, nameKey])
  @@index([communityId, sortOrder, createdAt, id])
  @@index([createdById])
}

model CommunityMember {
  communityId             String                 @db.Uuid
  userId                  String                 @db.Uuid
  displayName             String?                @db.VarChar(80)
  role                    CommunityRole          @default(MEMBER)
  joinedAt                DateTime               @default(now()) @db.Timestamptz(6)
  community               Community              @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user                    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeParticipations ChallengeParticipant[]
  gameRoomPlayers         GameRoomPlayer[]
  arenaGladiator          ArenaGladiator?

  @@id([communityId, userId])
  @@index([userId])
}

model ArenaGladiator {
  id                  String               @id @default(uuid()) @db.Uuid
  communityId         String               @db.Uuid
  userId              String               @db.Uuid
  name                String               @db.VarChar(40)
  origin              String               @db.VarChar(32)
  entryLine           String?              @db.VarChar(120)
  victoryLine         String?              @db.VarChar(120)
  appearance          Json
  level               Int                  @default(1)
  experience          Int                  @default(0)
  gold                Int                  @default(500)
  fame                Int                  @default(0)
  unspentSkillPoints  Int                  @default(0)
  strength            Int
  agility             Int
  technique           Int
  defence             Int
  vitality            Int
  presence            Int
  stamina             Int
  wins                Int                  @default(0)
  losses              Int                  @default(0)
  campaignStep        Int                  @default(0)
  campaignCompletions Int                  @default(0)
  injuredUntil        DateTime?            @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)
  member              CommunityMember      @relation(fields: [communityId, userId], references: [communityId, userId], onDelete: Cascade)
  inventory           ArenaInventoryItem[]
  battles             ArenaBattle[]
  shelter             ArenaShelter?
  occupations         ArenaOccupation[]
  outgoingRaids       ArenaPvpRaid[]       @relation("ArenaPvpAttacker")
  incomingRaids       ArenaPvpRaid[]       @relation("ArenaPvpDefender")

  @@unique([communityId, userId])
  @@index([communityId, fame, level, id])
  @@index([communityId, campaignCompletions, fame, wins, id])
  @@index([userId])
  @@index([injuredUntil])
}

model ArenaPvpRaid {
  id               String             @id @default(uuid()) @db.Uuid
  communityId      String             @db.Uuid
  attackerId       String             @db.Uuid
  defenderId       String             @db.Uuid
  status           ArenaPvpRaidStatus @default(ACTIVE)
  durationMinutes  Int
  goldStolen       Int                @default(0)
  experienceReward Int                @default(0)
  attackerScore    Int?
  defenderScore    Int?
  attackerSnapshot Json
  defenderSnapshot Json
  startedAt        DateTime           @default(now()) @db.Timestamptz(6)
  endsAt           DateTime           @db.Timestamptz(6)
  resolvedAt       DateTime?          @db.Timestamptz(6)
  injuryEndsAt     DateTime?          @db.Timestamptz(6)
  attacker         ArenaGladiator     @relation("ArenaPvpAttacker", fields: [attackerId], references: [id], onDelete: Cascade)
  defender         ArenaGladiator     @relation("ArenaPvpDefender", fields: [defenderId], references: [id], onDelete: Cascade)

  @@index([communityId, status, endsAt])
  @@index([attackerId, startedAt, id])
  @@index([defenderId, startedAt, id])
}

model ArenaOccupation {
  id                  String                @id @default(uuid()) @db.Uuid
  gladiatorId         String                @db.Uuid
  taskKey             String                @db.VarChar(48)
  kind                ArenaOccupationKind
  status              ArenaOccupationStatus @default(ACTIVE)
  durationHours       Int
  goldReward          Int                   @default(0)
  experienceReward    Int                   @default(0)
  shelterPointsReward Int                   @default(0)
  incident            ArenaIncidentKind?
  resultMessage       String?               @db.VarChar(240)
  startedAt           DateTime              @default(now()) @db.Timestamptz(6)
  endsAt              DateTime              @db.Timestamptz(6)
  finishedAt          DateTime?             @db.Timestamptz(6)
  effectExpiresAt     DateTime?             @db.Timestamptz(6)
  gladiator           ArenaGladiator        @relation(fields: [gladiatorId], references: [id], onDelete: Cascade)

  @@index([gladiatorId, status, endsAt])
  @@index([gladiatorId, finishedAt, id])
  @@index([effectExpiresAt])
}

model ArenaShelter {
  gladiatorId String             @id @db.Uuid
  level       Int                @default(1)
  points      Int                @default(0)
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(6)
  gladiator   ArenaGladiator     @relation(fields: [gladiatorId], references: [id], onDelete: Cascade)
  items       ArenaShelterItem[]

  @@index([level, points])
}

model ArenaShelterItem {
  id             String       @id @default(uuid()) @db.Uuid
  shelterId      String       @db.Uuid
  catalogItemKey String       @db.VarChar(80)
  acquiredAt     DateTime     @default(now()) @db.Timestamptz(6)
  shelter        ArenaShelter @relation(fields: [shelterId], references: [gladiatorId], onDelete: Cascade)

  @@unique([shelterId, catalogItemKey])
  @@index([shelterId, acquiredAt, id])
  @@index([catalogItemKey])
}

model ArenaInventoryItem {
  id             String         @id @default(uuid()) @db.Uuid
  gladiatorId    String         @db.Uuid
  catalogItemKey String         @db.VarChar(80)
  quantity       Int            @default(1)
  equippedSlot   String?        @db.VarChar(32)
  metadata       Json?
  acquiredAt     DateTime       @default(now()) @db.Timestamptz(6)
  gladiator      ArenaGladiator @relation(fields: [gladiatorId], references: [id], onDelete: Cascade)

  @@unique([gladiatorId, catalogItemKey])
  @@index([gladiatorId, acquiredAt, id])
  @@index([catalogItemKey])
}

model ArenaBattle {
  id                  String            @id @default(uuid()) @db.Uuid
  gladiatorId         String            @db.Uuid
  opponentKey         String            @db.VarChar(48)
  status              ArenaBattleStatus @default(ACTIVE)
  round               Int               @default(1)
  playerHealth        Int
  playerEnergy        Int
  playerPosition      Int               @default(2)
  playerGuarded       Boolean           @default(false)
  opponentHealth      Int
  opponentEnergy      Int
  opponentPosition    Int               @default(8)
  opponentGuarded     Boolean           @default(false)
  goldReward          Int               @default(0)
  experienceReward    Int               @default(0)
  fameReward          Int               @default(0)
  skillPointsReward   Int               @default(0)
  shelterPointsReward Int               @default(0)
  playerSnapshot      Json
  opponentSnapshot    Json
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(6)
  finishedAt          DateTime?         @db.Timestamptz(6)
  gladiator           ArenaGladiator    @relation(fields: [gladiatorId], references: [id], onDelete: Cascade)
  turns               ArenaBattleTurn[]

  @@index([gladiatorId, status, createdAt])
}

model ArenaBattleTurn {
  id               String            @id @default(uuid()) @db.Uuid
  battleId         String            @db.Uuid
  round            Int
  playerAction     ArenaBattleAction
  opponentAction   ArenaBattleAction
  actingFirst      ArenaBattleActor
  events           Json
  playerHealth     Int
  playerEnergy     Int
  playerPosition   Int
  opponentHealth   Int
  opponentEnergy   Int
  opponentPosition Int
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  battle           ArenaBattle       @relation(fields: [battleId], references: [id], onDelete: Cascade)

  @@unique([battleId, round])
  @@index([battleId, createdAt])
}

model GameRoom {
  id              String           @id @default(uuid()) @db.Uuid
  communityId     String           @db.Uuid
  createdById     String           @db.Uuid
  gameType        GameType
  name            String           @db.VarChar(80)
  status          GameRoomStatus   @default(WAITING)
  rules           Json
  roundNumber     Int              @default(0)
  version         Int              @default(0)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  community       Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy       User             @relation("GameRoomCreator", fields: [createdById], references: [id], onDelete: Restrict)
  players         GameRoomPlayer[]
  matches         GameMatch[]
  hangmanSessions HangmanSession[]
  stopSessions    StopSession[]

  @@unique([id, communityId])
  @@index([communityId, status, updatedAt, id])
  @@index([createdById])
}

model GameRoomPlayer {
  roomId      String          @db.Uuid
  communityId String          @db.Uuid
  userId      String          @db.Uuid
  seat        Int
